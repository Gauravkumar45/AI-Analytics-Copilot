# LLM: any OpenAI-compatible endpoint. Groq is the default.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
# Local alternative: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b

# Database: defaults to the SQLite demo DB. For PostgreSQL:
# DATABASE_URL=postgresql://admin:password@localhost:5432/analytics

# Safety limits
MAX_SQL_ATTEMPTS=3
MAX_TOOL_CALLS=6
MAX_RESULT_ROWS=500
QUERY_TIMEOUT_SECONDS=5
RATE_LIMIT_PER_MINUTE=10
# ALLOWED_TABLES=orders,order_items,products,customers

# Optional login for the /api/auth endpoints
ADMIN_USERNAME=
ADMIN_PASSWORD=
SECRET_KEY=
